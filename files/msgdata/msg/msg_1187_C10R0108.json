      "id": "msg_1187_C10R0108_00024",
      "en_US": [
        "OK, let me count your Coupons!\n",
        "I’ll use the Pokétch here...\r",
        "One, two, three!\n",
        "Bravo! I say, bravo!\r",
        "In return for these Coupons,\n",
        "I present you this Pokémon Watch,\\for Pokétch for short!\r"
      ]
    },
    {
      "id": "msg_1187_C10R0108_00025",
      "en_US": "{STRVAR_1 3, 0, 0} received a {COLOR 1}Pokétch{COLOR 0}!{YESNO 1}"
    },
