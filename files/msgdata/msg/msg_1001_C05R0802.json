{
  "key": 8308,
  "messages": [
    {
      "id": "msg_1001_C05R0802_00000",
      "en_US": [
        "All my grandchildren are clamoring\n",
        "for Pokémon of their own.\r",
        "It may be tricky to manage it, but\n",
        "it will brighten up the mood more."
      ]
    },
    {
      "id": "msg_1001_C05R0802_00001",
      "en_US": [
        "Oh, no, there are no stairs in\n",
        "this house. It’s easier that way.\r",
        "The lack of stairs makes it easy for\n",
        "the little Pokémon to get about."
      ]
    },
    {
      "id": "msg_1001_C05R0802_00002",
      "en_US": [
        "A world in which people are\n",
        "compassionate to others...\r",
        "That’s all that matters to me."
      ]
    },
    {
      "id": "msg_1001_C05R0802_00003",
      "en_US": [
        "Hearthome is a kid-friendly city,\n",
        "they say, but I disagree.\r",
        "Hearthome is friendly to kids,\n",
        "grown-ups, and Pokémon too."
      ]
    }
  ]
}