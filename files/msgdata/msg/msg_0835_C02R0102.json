{
  "key": 8244,
  "messages": [
    {
      "id": "msg_0835_C02R0102_00000",
      "en_US": [
        "The books on the third floor are\n",
        "easy to read.\r",
        "The ones down here are all too tough\n",
        "for me to understand..."
      ]
    },
    {
      "id": "msg_0835_C02R0102_00001",
      "en_US": [
        "I looked up a book called\n",
        "“Surviving Disasters” right away!"
      ]
    },
    {
      "id": "msg_0835_C02R0102_00002",
      "en_US": [
        "The ceiling-high bookshelves are\n",
        "crammed with books."
      ]
    },
    {
      "id": "msg_0835_C02R0102_00003",
      "en_US": [
        "The shelves are lined with books\n",
        "worn from being read by many."
      ]
    },
    {
      "id": "msg_0835_C02R0102_00004",
      "en_US": [
        "Please refrain from bringing food\n",
        "or beverages into the library."
      ]
    }
  ]
}