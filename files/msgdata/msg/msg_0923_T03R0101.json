{
  "key": 8708,
  "messages": [
    {
      "id": "msg_0923_T03R0101_00000",
      "en_US": [
        "A single Berry will grow into a plant\n",
        "that makes several Berries.\r",
        "By planting one, there will be more\n",
        "and more Berries in the world.\r",
        "I hope you will help us spread more\n",
        "Berries everywhere!\r"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00001",
      "en_US": [
        "Please come by again tomorrow.\n",
        "I’ll pick a different Berry for you.\r",
        "Please plant that Berry in soft,\n",
        "earthy soil!"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00002",
      "en_US": [
        "Trainer, please water Berries using\n",
        "this Sprayduck watering can.\r"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00003",
      "en_US": [
        "Use that Sprayduck to water the soil\n",
        "where you’ve planted Berries.\r",
        "You should also water Berry plants\n",
        "while they are growing."
      ]
    },
    {
      "id": "msg_0923_T03R0101_00004",
      "en_US": [
        "Hello!\r",
        "Would you like to exchange your\n",
        "Berries for some Accessories?"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00005",
      "en_US": [
        "Thank you so much for trading us so\n",
        "many Berries!"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00006",
      "en_US": "Which Accessory would you like?"
    },
    {
      "id": "msg_0923_T03R0101_00007",
      "en_US": [
        "Will you exchange {STRVAR_1 52, 1, 0} {STRVAR_1 8, 0, 0}\n",
        "for the {STRVAR_1 31, 2, 0}?"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00008",
      "en_US": "Thank you!"
    },
    {
      "id": "msg_0923_T03R0101_00009",
      "en_US": "You don’t have enough Berries."
    },
    {
      "id": "msg_0923_T03R0101_00010",
      "en_US": [
        "Oh, you can’t carry any more\n",
        "than that."
      ]
    },
    {
      "id": "msg_0923_T03R0101_00011",
      "en_US": "Please come again!"
    },
    {
      "id": "msg_0923_T03R0101_00012",
      "en_US": [
        "You got the {STRVAR_1 31, 2, 0} in return\n",
        "for {STRVAR_1 52, 1, 0} {STRVAR_1 8, 0, 0}."
      ]
    },
    {
      "id": "msg_0923_T03R0101_00013",
      "en_US": [
        "Wow! I traded away every single\n",
        "Accessory I had!"
      ]
    },
    {
      "id": "msg_0923_T03R0101_00014",
      "en_US": "YES"
    },
    {
      "id": "msg_0923_T03R0101_00015",
      "en_US": "NO"
    },
    {
      "id": "msg_0923_T03R0101_00016",
      "en_US": "{STRVAR_1 8, 0, 0}"
    },
    {
      "id": "msg_0923_T03R0101_00017",
      "en_US": "Needed: {STRVAR_1 52, 1, 0} "
    },
    {
      "id": "msg_0923_T03R0101_00018",
      "en_US": "In Bag: {STRVAR_1 52, 2, 0}"
    },
    {
      "id": "msg_0923_T03R0101_00019",
      "en_US": "EXIT"
    }
  ]
}