{
  "key": 8694,
  "messages": [
    {
      "id": "msg_0886_T01R0202_00000",
      "en_US": [
        "Despite the exploration team’s best\n",
        "efforts, the rare, oddly colored\n",
        "Pokémon eluded detection.\n",
        "The rumored red GYARADOS failed to\n",
        "appear to the dispirited team..."
      ]
    },
    {
      "id": "msg_0886_T01R0202_00001",
      "en_US": [
        "That concludes our special report,\n",
        "“Search for the Red GYARADOS!”\r",
        "Brought to you by Jubilife TV on\n",
        "Nationwide Net!\r"
      ]
    },
    {
      "id": "msg_0886_T01R0202_00002",
      "en_US": [
        "See you next week, same time,\n",
        "same channel!"
      ]
    },
    {
      "id": "msg_0886_T01R0202_00003",
      "en_US": [
        "The TV is showing the title screen\n",
        "of a video game."
      ]
    },
    {
      "id": "msg_0886_T01R0202_00004",
      "en_US": [
        "The X Button\n",
        "opens the menu!"
      ]
    },
    {
      "id": "msg_0886_T01R0202_00005",
      "en_US": [
        "It’s a Wii!\n",
        "It’s controlled by a Wii Remote!"
      ]
    },
    {
      "id": "msg_0886_T01R0202_00006",
      "en_US": [
        "{STRVAR_1 3, 0, 0} checked the PC.\r",
        "Pokémon Basics...\r",
        "People live alongside Pokémon in\n",
        "this world.\r",
        "The people that battle Pokémon are\n",
        "called Pokémon Trainers."
      ]
    }
  ]
}