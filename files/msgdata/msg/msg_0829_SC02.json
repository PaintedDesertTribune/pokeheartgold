    },
    {
      "id": "msg_0829_SC02_00037",
      "en_US": "Canalave Dock"
    },
    {
      "id": "msg_0829_SC02_00038",
      "en_US": [
        "Harbor Inn...\n",
        "The text is too faded to read."
      ]
    },
    {
      "id": "msg_0829_SC02_00039",
      "en_US": [
        "Harbor Inn\n",
        "A Roost for Restless Sailors\r",
        "“Enjoy sweet dreams in our\n",
        "sumptuous beds!”"
      ]
    },
    {
      "id": "msg_0829_SC02_00040",
      "en_US": [
        "The door is tightly shut.\n",
        "It appears impossible to open."
      ]
    },
