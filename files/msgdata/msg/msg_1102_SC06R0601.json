{
  "key": 8326,
  "messages": [
    {
      "id": "msg_1102_SC06R0601_00000",
      "en_US": [
        "Howdy, there!\r",
        "Let me examine your Pokémon to see\n",
        "if it’s worthy of a scarf!\r"
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00001",
      "en_US": [
        "Hmhm...\n",
        "I see...\r"
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00002",
      "en_US": [
        "This isn’t what I had hoped to see...\r",
        "I can’t lie to you, so I’ll just have\n",
        "to tell it to you straight.\r",
        "This Pokémon’s not bad, but it’s not\n",
        "good, either. It’s just so-so.\r",
        "If you want to improve this one’s\n",
        "condition, feed it some more Poffins!"
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00003",
      "en_US": [
        "Your Pokémon is growing up really\n",
        "good. My hat’s off to you.\r",
        "I was going to give you a scarf,\n",
        "but your Bag’s full."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00004",
      "en_US": [
        "Your {STRVAR_1 0, 0, 0}’s looking good!\n",
        "I’d say it’s pretty impressive!\r",
        "I’ll tell you what, I’ll give you\n",
        "this {STRVAR_1 8, 1, 0}!\r"
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00005",
      "en_US": [
        "The Red Scarf stands for passion!\r",
        "Let a Pokémon hold it to give it\n",
        "an edge in Cool Contests."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00006",
      "en_US": [
        "The Blue Scarf represents the\n",
        "vastness of the sea!\r",
        "Let a Pokémon hold it to give it\n",
        "an edge in Beauty Contests."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00007",
      "en_US": [
        "The Pink Scarf represents charm!\r",
        "Let a Pokémon hold it to give it\n",
        "an edge in Cute Contests."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00008",
      "en_US": [
        "The Green Scarf represents the\n",
        "spring breeze!\r",
        "Let a Pokémon hold it to give it\n",
        "an edge in Smart Contests."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00009",
      "en_US": [
        "The Yellow Scarf stands for\n",
        "toughness!\r",
        "Let a Pokémon hold it to give it\n",
        "an edge in Tough Contests."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00010",
      "en_US": [
        "I’m out of scarves to give you!\n",
        "I’m out of things to say, too!"
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00011",
      "en_US": [
        "My brother’s girlfriend is the\n",
        "Massage Girl in Veilstone City.\r",
        "They stay in touch by having Pokémon\n",
        "hold Mail for each other."
      ]
    },
    {
      "id": "msg_1102_SC06R0601_00012",
      "en_US": "PACHIRISU: Suuu pasuu!"
    }
  ]
}